---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import GraphView from '../../components/GraphView';
import { Icon } from '../../components/Icon';

const wikiEntries = await getCollection('wiki');
const nodes = wikiEntries.map(entry => ({ id: entry.slug, name: entry.data.title, val: 1 }));

// Extract links from content dynamically
const links = wikiEntries.flatMap(entry => {
    const content = entry.body;
    const linkRegex = /\[\[(.*?)\]\]/g;
    const matches = [...content.matchAll(linkRegex)];
    
    return matches.map(match => {
        const targetSlug = match[1];
        // Ensure target exists in our simple node list (optional but safer)
        if (nodes.find(n => n.id === targetSlug)) {
             return { source: entry.slug, target: targetSlug };
        }
        return null;
    }).filter(l => l !== null);
});

const graphData = { nodes, links };
---

<Layout title="Wiki Index | Linktree">
    <div class="w-full max-w-4xl animate-slide-up">
        <h1 class="text-4xl font-bold text-center mb-8 bg-clip-text text-transparent bg-gradient-to-r from-purple-400 to-pink-300">
            Digital Garden
        </h1>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Sidebar / List -->
            <div class="md:col-span-1 flex flex-col gap-4">
                <div class="glass-panel p-6 rounded-2xl">
                    <h2 class="text-xl font-semibold mb-4 text-white flex items-center gap-2">
                        <Icon name="file-text" size={20} /> Articles
                    </h2>
                    <ul class="space-y-2">
                        {wikiEntries.map(entry => (
                            <li>
                                <a href={`/wiki/${entry.slug}`} class="block p-2 rounded-lg hover:bg-white/5 text-slate-300 hover:text-white transition-colors">
                                    {entry.data.title}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>

            <!-- Graph View Area -->
            <div class="md:col-span-2">
                <div class="glass-panel p-1 rounded-2xl h-[400px] overflow-hidden relative">
                    <div class="absolute inset-0 bg-slate-900/50"></div>
                     <!-- Graph View Component (Client-side only) -->
                     <GraphView data={graphData} client:only="react" />
                </div>
            </div>
        </div>

        <div class="mt-8 text-center">
            <a href="/" class="text-slate-400 hover:text-white transition-colors">&larr; Back to Home</a>
        </div>
    </div>
</Layout>
