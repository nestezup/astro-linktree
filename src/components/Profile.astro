---
import type { Profile } from '../types';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<div class="flex flex-col items-center mb-8 text-center animate-slide-up">
  <div class="relative group">
    <div class="absolute -inset-0.5 bg-gradient-to-r from-pink-500 to-purple-500 rounded-full opacity-75 group-hover:opacity-100 transition duration-200 blur"></div>
    <img 
      src={profile.avatarUrl} 
      alt={profile.name} 
      class="relative w-24 h-24 rounded-full border-2 border-slate-900 object-cover"
    />
  </div>
  
  <h1 class="mt-4 text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white to-purple-200">
    {profile.name}
  </h1>
  
  <p class="mt-2 text-slate-400 max-w-xs text-sm">
    {profile.bio}
  </p>
</div>
